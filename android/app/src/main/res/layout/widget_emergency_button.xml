<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_button_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_samsung_lockscreen_pill"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_button_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_medical_emergency_logo"
        android:contentDescription="Emergency Medical ID" />
</FrameLayout>
