<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_button_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_emergency_button_bg"
    android:padding="6dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/widget_button_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_medical_emergency_logo"
        android:contentDescription="Emergency Medical ID" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="EMERGENCY"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_button_blood_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLOOD: O+"
        android:textColor="#FCA5A5"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>
