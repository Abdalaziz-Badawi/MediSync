<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emergency_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp">

    <!-- Centered Emergency Medical ID Card Container -->
    <LinearLayout
        android:id="@+id/emergency_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/emergency_card_white_bg"
        android:elevation="14dp">

        <!-- 1. Red Header Banner with Medical Cross and Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/emergency_card_header_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_medical_emergency_logo"
                android:contentDescription="Emergency Medical Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY MEDICAL ID"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE VERIFIED • ZERO PIN ACCESS"
                    android:textColor="#FEE2E2"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textColor="#DC2626"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#FFFFFF"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 2. Scrollable Verified Patient Health Information -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <!-- Patient Full Name -->
                <TextView
                    android:id="@+id/tv_patient_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT NAME"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Demographics (DOB, Age, Gender) -->
                <TextView
                    android:id="@+id/tv_demographics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="BORN: --   •   GENDER: --"
                    android:textColor="#475569"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- 1. Primary Vitals Row: Blood Group & Organ Donor (50/50 split) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false">

                    <!-- Blood Type Hero Badge -->
                    <LinearLayout
                        android:id="@+id/layout_blood_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/emergency_blood_badge_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩸 BLOOD TYPE"
                            android:textColor="#B91C1C"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_blood_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="O+"
                            android:textColor="#DC2626"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRANSFUSION VITAL"
                            android:textColor="#991B1B"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <!-- Organ Donor Hero Badge -->
                    <LinearLayout
                        android:id="@+id/layout_donor_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:background="@drawable/emergency_donor_badge_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🫀 ORGAN DONOR"
                            android:textColor="#475569"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_organ_donor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YES"
                            android:textColor="#059669"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_donor_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REGISTERED DONOR"
                            android:textColor="#047857"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. Full-Width National Health / Medical ID Bar (100% width, ZERO truncation) -->
                <LinearLayout
                    android:id="@+id/layout_health_id_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/emergency_health_id_badge_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🆔 NATIONAL HEALTH ID: "
                        android:textColor="#475569"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_health_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not Provided"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Priority 1: Critical Drug Allergies & Contraindications (High-Alert Red Box) -->
                <LinearLayout
                    android:id="@+id/layout_allergies_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/emergency_allergies_box_bg"
                    android:padding="12dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ CRITICAL ALLERGIES &amp; CONTRAINDICATIONS"
                        android:textColor="#991B1B"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_allergies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="NO KNOWN DRUG ALLERGIES (NKDA)"
                        android:textColor="#7F1D1D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_allergies_warning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="STOP • SEVERE ANAPHYLAXIS RISK • VERIFY BEFORE DRUG ADMINISTRATION"
                        android:textColor="#B91C1C"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Priority 2: Clinical Conditions & Procedural History (Secondary Health Box) -->
                <LinearLayout
                    android:id="@+id/layout_clinical_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/emergency_clinical_box_bg"
                    android:padding="11dp"
                    android:layout_marginTop="9dp">

                    <!-- Chronic Conditions & Organ Risks Sub-item -->
                    <LinearLayout
                        android:id="@+id/layout_conditions_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩺 CHRONIC CONDITIONS &amp; ORGAN RISKS:"
                            android:textColor="#0F766E"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_conditions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="None reported."
                            android:textColor="#134E4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Past Surgeries & Procedures Sub-item -->
                    <LinearLayout
                        android:id="@+id/layout_surgeries_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="7dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏥 PAST SURGERIES &amp; PROCEDURES:"
                            android:textColor="#4338CA"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_surgeries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="None recorded."
                            android:textColor="#1E1B4B"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Past Medical History / Diseases Sub-item -->
                    <LinearLayout
                        android:id="@+id/layout_history_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="7dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📑 PAST MEDICAL HISTORY / DISEASES:"
                            android:textColor="#0369A1"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_history"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="None recorded."
                            android:textColor="#0C4A6E"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Priority 3: Current Active Medications Regimen -->
                <LinearLayout
                    android:id="@+id/layout_medications_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/emergency_medications_box_bg"
                    android:padding="11dp"
                    android:layout_marginTop="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 CURRENT ACTIVE MEDICATIONS"
                        android:textColor="#1E293B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_medications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="No active regular medications recorded."
                        android:textColor="#334155"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Priority 4: Discontinued High-Risk Medications Section -->
                <LinearLayout
                    android:id="@+id/layout_discontinued_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/emergency_discontinued_box_bg"
                    android:padding="11dp"
                    android:layout_marginTop="9dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ DISCONTINUED HIGH-RISK MEDICATIONS"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_discontinued"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#78350F"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quick Call 112 Emergency Button -->
                <Button
                    android:id="@+id/btn_call_emergency"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/emergency_call_btn_bg"
                    android:text="📞  CALL 112 (EMERGENCY)"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>